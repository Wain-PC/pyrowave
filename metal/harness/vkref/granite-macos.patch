@@ -138,6 +138,16 @@ void sleep_until_nsecs(int64_t timepoint)
 		_mm_pause();
 #endif
 	}
+#elif defined(__APPLE__)
+	// Local macOS build fix: Darwin has no clock_nanosleep().
+	int64_t d = timepoint - get_current_time_nsecs();
+	if (d > 0)
+	{
+		struct timespec ts = {};
+		ts.tv_sec = d / 1000000000ll;
+		ts.tv_nsec = d % 1000000000ll;
+		while (nanosleep(&ts, &ts) == -1 && errno == EINTR) {}
+	}
 #else
 	constexpr auto timebase = CLOCK_MONOTONIC;
 	struct timespec ts = {};
